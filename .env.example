# =============================================================================
# Baleen — environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# X (Twitter) API — official v2, recent-search endpoint (tweepy)
# Generate at https://developer.x.com (Project > Keys and tokens > Bearer Token)
# -----------------------------------------------------------------------------
X_API_BEARER_TOKEN=your-x-api-bearer-token
X_USER_HANDLES=unusual_whales,congress_trades
# How far back each poll looks (seconds). Recent-search window is limited to 7 days.
X_SEARCH_WINDOW_SECONDS=3600
# Max result pages fetched per poll (100 tweets each); follows next_token.
X_MAX_PAGES=3
# Per-request timeout for X API calls (seconds). A hung endpoint otherwise
# blocks the scheduler tick indefinitely (tweepy passes no timeout through).
X_API_TIMEOUT_SECONDS=30
# Minimum number of fetches between polls (seconds).
POLL_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# SEC EDGAR (Form 4 insider filings) — keyless, but the SEC admits only
# clients that identify with contact info. Put yours here.
# -----------------------------------------------------------------------------
EDGAR_USER_AGENT=Baleen/1.0 (SEC EDGAR Form 4 research; contact: admin@example.com)

# -----------------------------------------------------------------------------
# LLM — locally hosted vLLM serving an open-weight model via its
# OpenAI-compatible API (/v1/chat/completions).
# Placeholders below are fine for local development; point these at the real
# vLLM instance when credentials are available. See docs/SETUP.md.
# -----------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=placeholder-key
LLM_MODEL_NAME=your-model-name
# auto = use native tool-calling, fall back to constrained JSON if unsupported
# tools = force native tool-calling
# json = force constrained-JSON fallback
LLM_TOOL_MODE=auto
# Per-request timeout for LLM calls (seconds); retries bounded by LLM_MAX_RETRIES.
LLM_MAX_RETRIES=2
LLM_TIMEOUT_SECONDS=90
# Groq backup (OpenAI-compatible): used only when the primary LLM raises.
# Leave GROQ_API_KEY empty to disable the backup.
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
GROQ_MODEL_NAME=openai/gpt-oss-20b
# Extraction confidence threshold; below this, events are stored as UnparsedEvent.
CONFIDENCE_THRESHOLD=0.6
# False drafts briefs from the deterministic template (same facts, no prose
# polish) instead of calling the model per event. Set false on free tiers.
REPORTS_LLM_BRIEFS=true

# -----------------------------------------------------------------------------
# PostgreSQL (raw tweet + alert storage)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=baleen
POSTGRES_USER=baleen
POSTGRES_PASSWORD=baleen
DATABASE_URL=postgresql+psycopg://baleen:baleen@localhost:5432/baleen

# -----------------------------------------------------------------------------
# Neo4j (knowledge graph)
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=baleen_dev_pass
# Neo4j version bundled in docker-compose (affects auth scheme).
NEO4J_VERSION=5
# Optional defense-in-depth: a read-only Neo4j role for the query agent + alert
# engine. Until NEO4J_READ_URI is set, read queries use the writer driver (the
# Cypher allowlist is the real guardrail). See docs/SETUP.md for role SQL.
# NEO4J_READ_URI=bolt://localhost:7687
# NEO4J_READ_USER=baleen_reader
# NEO4J_READ_PASSWORD=changeme
# Cap on any single Cypher statement (seconds); 0 disables the cap. Protects the
# API and query agent from pathological queries.
NEO4J_QUERY_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Scheduler (APScheduler)
# -----------------------------------------------------------------------------
SCHEDULER_ENABLED=true
# Seed the default alert rule into Postgres on backend startup.
SEED_DEFAULT_ALERTS=true
# Tweets drained per processing pass (extract -> graph -> alert).
PROCESS_BATCH_SIZE=100

# --- API auth / rate limiting (leave empty for local dev) ---
# When set, /api/query, /api/graph and /api/stream require:
#   Authorization: Bearer <API_KEY>
API_KEY=
# Sliding-window rate limit per IP. Window=0 means unlimited.
API_RATE_WINDOW_SECONDS=0
API_RATE_MAX_REQUESTS=30
