# =============================================================================
# Baleen — environment template
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# X (Twitter) API — official v2, recent-search endpoint (tweepy)
# Generate at https://developer.x.com (Project > Keys and tokens > Bearer Token)
# -----------------------------------------------------------------------------
X_API_BEARER_TOKEN=your-x-api-bearer-token
X_USER_HANDLES=unusual_whales,congress_trades
# How far back each poll looks (seconds). Recent-search window is limited to 7 days.
X_SEARCH_WINDOW_SECONDS=3600
# Minimum number of fetches between polls (seconds).
POLL_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# LLM — locally hosted vLLM serving an open-weight model via its
# OpenAI-compatible API (/v1/chat/completions).
# Placeholders below are fine for local development; point these at the real
# vLLM instance when credentials are available. See docs/SETUP.md.
# -----------------------------------------------------------------------------
LLM_BASE_URL=http://localhost:8001/v1
LLM_API_KEY=placeholder-key
LLM_MODEL_NAME=your-model-name
# auto = use native tool-calling, fall back to constrained JSON if unsupported
# tools = force native tool-calling
# json = force constrained-JSON fallback
LLM_TOOL_MODE=auto
# Extraction confidence threshold; below this, events are stored as UnparsedEvent.
CONFIDENCE_THRESHOLD=0.6

# -----------------------------------------------------------------------------
# PostgreSQL (raw tweet + alert storage)
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=baleen
POSTGRES_USER=baleen
POSTGRES_PASSWORD=baleen
DATABASE_URL=postgresql+psycopg://baleen:baleen@localhost:5432/baleen

# -----------------------------------------------------------------------------
# Neo4j (knowledge graph)
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=baleen_dev_pass
# Neo4j version bundled in docker-compose (affects auth scheme).
NEO4J_VERSION=5

# -----------------------------------------------------------------------------
# Scheduler (APScheduler)
# -----------------------------------------------------------------------------
SCHEDULER_ENABLED=true
